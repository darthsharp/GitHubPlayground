{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "GhInfo": "Information",
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "GitHub": {
    "BaseAddress": "https://api.github.com/",
    "UserAgent": "gh-info/1.0"
  },
  "Cache": {
    "TimeToLiveMinutes": 15
  }
}
