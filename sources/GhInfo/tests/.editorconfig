root = false

[*.cs]
# CA2007: Consider calling ConfigureAwait on the awaited task.
# In tests there is no synchronization context to capture, so .ConfigureAwait(false) adds noise.
dotnet_diagnostic.CA2007.severity = none

# CA1707: Identifiers should not contain underscores.
# xUnit test names use the Method_Scenario_ExpectedBehavior convention.
dotnet_diagnostic.CA1707.severity = none

# CA1305: IFormatProvider — invariant in tests is fine.
dotnet_diagnostic.CA1305.severity = none

# CA1861: Avoid constant arrays as arguments. Small literal arrays in tests are clearer than named constants.
dotnet_diagnostic.CA1861.severity = none

# xUnit1051: Prefer TestContext.Current.CancellationToken. Not relevant for these unit tests.
dotnet_diagnostic.xUnit1051.severity = none
